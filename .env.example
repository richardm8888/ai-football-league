# Database ---------------------------------------------------------------
# docker compose up -d db  ->  postgresql://aifl:aifl@localhost:5432/aifl
# npm run pg:start         ->  postgresql://aifl:aifl@127.0.0.1:5433/aifl
DATABASE_URL="postgresql://aifl:aifl@127.0.0.1:5433/aifl"
TEST_DATABASE_URL="postgresql://aifl:aifl@127.0.0.1:5433/aifl_test"

# Session signing. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32-byte-hex-string"

# AI coaching staff ------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run the deterministic local coach, which
# keeps every AI workflow usable without a provider account.
AI_PROVIDER="anthropic"        # anthropic | local
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="45000"
AI_MAX_RETRIES="2"

# Set to 1 to allow anyone to register. Otherwise an invite code is required.
ALLOW_OPEN_REGISTRATION="1"
