# Database ---------------------------------------------------------------
# docker compose up -d db  ->  postgresql://aifl:aifl@localhost:5432/aifl
# npm run pg:start         ->  postgresql://aifl:aifl@127.0.0.1:5433/aifl
DATABASE_URL="postgresql://aifl:aifl@127.0.0.1:5433/aifl"
TEST_DATABASE_URL="postgresql://aifl:aifl@127.0.0.1:5433/aifl_test"

# Session signing. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32-byte-hex-string"

# AI coaching staff ------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run the deterministic local coach, which
# keeps every AI workflow usable without a provider account.
AI_PROVIDER="anthropic"        # anthropic | local
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="45000"
AI_MAX_RETRIES="2"

# Set to 1 to allow anyone to register. Otherwise an invite code is required.
ALLOW_OPEN_REGISTRATION="1"

# Deployment -------------------------------------------------------------
# Only needed on the droplet, where this file sits beside
# docker-compose.prod.yml. See docs/DEPLOY.md.
#
# APP_IMAGE points at the published image so the droplet pulls rather than
# builds. TAG is the commit being served and is rewritten by every deploy —
# set it once and then leave it alone.
#
# APP_IMAGE="ghcr.io/richardm8888/ai-football-league"
# TAG="latest"
#
# In production DATABASE_URL is the managed DigitalOcean cluster. Note the
# port (25060, not 5432), the required sslmode, and connection_limit: managed
# clusters cap connections low enough that Prisma's default pool can exhaust
# them on its own.
#
# DATABASE_URL="postgresql://doadmin:PASSWORD@db-postgresql-lon1-00000-do-user-000000-0.l.db.ondigitalocean.com:25060/aifl?sslmode=require&connection_limit=5"
#
# APP_PORT="3000"        # host port the app is published on
# APP_BIND="127.0.0.1"   # loopback when a reverse proxy terminates TLS

